# Pin line endings so generated layers and the ledgers they
# describe are byte-identical on every platform (a CRLF
# checkout must not change a single hashed or compared byte).
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.rs text eol=lf
*.txt text eol=lf
